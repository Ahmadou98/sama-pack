{
  "name": "sama-pack",
  "main": "./worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/*.html",
      "/pwa.js",
      "/pwa.css",
      "/header.js",
      "/downloads/*",
      "/.well-known/assetlinks.json",
      "/fiche-produit.html",
      "/sitemap.xml"
    ]
  },
  "previews": {}
}

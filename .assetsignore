# Keep repository and deployment tooling files out of public static assets
.git/
.git/**
**/.git/**
.wrangler/
.wrangler/**
**/.wrangler/**
.assetsignore
.gitignore
wrangler.json
wrangler.jsonc
wrangler.toml
.dev.vars
.dev.vars.*
.env
.env.*
**/.env
**/.env.*
/supabase/
/supabase/**

# Exclude internal maintenance scripts, notes and local build artifacts
*.py
**/*.py
*.pyc
**/*.pyc
__pycache__/
**/__pycache__/
README*
readme.md
*.backup
*.backup-*
*.bak
*.tmp
*.log

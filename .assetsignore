# Keep repository and deployment tooling files out of public static assets
.git/
.git/**
**/.git/**
.wrangler/
.wrangler/**
**/.wrangler/**
.assetsignore
.gitignore
wrangler.json
wrangler.jsonc
wrangler.toml
.dev.vars
.dev.vars.*
.env
.env.*
**/.env
**/.env.*
/supabase/
/supabase/**

# Worker source is executed server-side and must never be published as a static asset
/worker.js

# Exclude internal maintenance scripts, notes and local build artifacts
*.py
**/*.py
*.pyc
**/*.pyc
__pycache__/
**/__pycache__/
README*
readme.md
*.backup
*.backup-*
*.bak
*.tmp
*.log

# Android TWA source and generated build output are not public website assets
/android/
/android/**
/.github/
/.github/**
